# Copy to .env (repo root). Read by docker compose (variable substitution) and by the backend when it runs on the
# host (`fastapi dev`, pytest integration runs). Never commit .env.

# production refuses default/short API keys and SQLite
APP_ENV=development
POSTGRES_PASSWORD=docintel-dev-only

# Host-side URLs (containers get their own internal URLs from docker-compose.yml)
DATABASE_URL=postgresql+psycopg://docintel:docintel-dev-only@localhost:5433/docintel
REDIS_URL=redis://localhost:6380/0
# inline | local | celery
QUEUE_BACKEND=celery

# API keys: the API accepts any key in API_KEYS; the web server sends BACKEND_API_KEY. Use >= 24 random chars, e.g.
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
API_KEYS=replace-with-a-long-random-key-0000
BACKEND_API_KEY=replace-with-a-long-random-key-0000
CORS_ORIGINS=http://localhost:3000
# optional "user:password" protecting the web UI
UI_BASIC_AUTH=

# Extraction
# rules | llm | hybrid
EXTRACTION_MODE=hybrid
# what a bare "$" means when the document says nothing else
DEFAULT_DOLLAR_CURRENCY=USD
# auto | DMY | MDY
DATE_ORDER=auto

# LLM provider: auto = anthropic if ANTHROPIC_API_KEY, else gemini if GEMINI_API_KEY, else local if LLM_BASE_URL
LLM_PROVIDER=auto
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3-flash-preview
# local llama.cpp server, from the host
LLM_BASE_URL=http://localhost:8080/v1
LLM_BASE_URL_IN_DOCKER=http://llm:8080/v1
LLM_MODEL=qwen3.5-9b
# file in ./models served by the `llm` compose service
LLM_GGUF=Qwen3.5-9B-Q4_K_M.gguf
# Upper bound of the document text sent to the LLM per call. The effective budget is derived from the model's context
# automatically, so this only caps it (raise it for a large-context model; Claude/Gemini use it as is).
LLM_MAX_INPUT_CHARS=20000
# For the local server the backend reads the per-request context from llama.cpp /props (vLLM: /v1/models) and uses
# (context - LLM_MAX_OUTPUT_TOKENS - prompt) x 3 characters, never more than LLM_MAX_INPUT_CHARS.
# Tokens one request may use, when the server does not report it (or uses a unified KV cache: context / slots)
# LLM_CONTEXT_TOKENS=8192
# JSON object merged into every OpenAI-compatible request (keys override the defaults; {} = send nothing extra).
# Unset: llama.cpp gets {"chat_template_kwargs":{"enable_thinking":false}}, any other server nothing.
# LLM_EXTRA_BODY={"chat_template_kwargs":{"enable_thinking":false}}
# llm compose service (llama.cpp): total context, parallel slots (context per request = LLM_CTX / LLM_PARALLEL)
# LLM_CTX=16384
# LLM_PARALLEL=2
# GPU layers in docker-compose.gpu.yml: auto (fit to free VRAM) | 99 (all layers)
# LLM_NGL=auto

# OCR / embeddings
# rapidocr | tesseract
OCR_ENGINE=rapidocr
# OCR process pool size per worker
OCR_WORKERS=4
# fastembed | hashing
EMBEDDING_PROVIDER=fastembed
